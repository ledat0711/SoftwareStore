// Created database on cloud supabase but can't connect to prisma yet, so currently using localhost to test.
datasource db {
    provider = "postgresql"
    // ****local****
    url = "postgresql://postgres:postgres@localhost:5432/postgres"

    // ****cloud****
    // url = env("DATABASE_URL")
    // directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Department {
  Apps
  Games
}

enum Platform {
  PC
  Mobile
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum EmailType {
  ORDER_SUCCESS
  ORDER_FAILED
  CART_ABANDONED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum DiscountScope {
  GLOBAL
  PRODUCT
  COUPON
}

enum DiscountValueType {
  PERCENT
  FIXED
}

enum DiscountStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum DiscountUsageStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Prisma có 2 loại field:
// A. Scalar fields → CÓ cột trong database
// B. Relation fields → KHÔNG có cột trong database
model Product {
  id          String   @id @default(cuid()) // Scalar fields
  slug        String   @unique   // dùng cho URL :slack-premium: http://localhost:3000/products/slack-premium
  title       String             // tên hiển thị
  description String?
  image       String?
  price       Float
  rating      Float?            
  tag         String?           // (Năng suất/Dev Tools/Thiết kế...) (fix: category => tag)
  badge       String?           //

  category    String?           // (Software/Apps/Games...) (fix: department => category)
  platform    String?           // PC/Mobile/All...

  hidden      Boolean  @default(false)
  isDeleted   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartItems   CartItem[] // Relation fields
  orderItems  OrderItem[] // Relation fields
  discountProducts DiscountProduct[]
}

// 1 user có 1 cart (giỏ hàng)
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  password      String?
  status        UserStatus      @default(ACTIVE)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  cart          Cart?
  roles         RoleUser[]   // 1-n với bảng trung gian
  orders        Order[]
  emailLogs EmailLog[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]
  discountUsages DiscountUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id    String       @id @default(cuid())
  name  String       @unique
  
  users RoleUser[]   // 1-n với bảng trung gian
}

// bảng trung gian RoleUser
model RoleUser {
  userId String
  roleId String
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId]) // composite primary key
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

// bảng cart và product có mối quan hệ n-n
// nên cần bảng trung gian CartItem
// checkedOut	Đã thanh toán chưa
// updatedAt	Lần cuối cart bị thêm/sửa/xoá item
// abandonedEmailSentAt	Đã gửi email abandoned chưa
// email	Email guest
// userId	Nếu là user đăng nhập
model Cart {
  id                   String     @id @default(cuid())
  userId               String?    @unique
  user                 User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                String?
  checkedOut           Boolean    @default(false)
  checkedOutAt         DateTime?
  abandonedEmailSentAt DateTime?
  items                CartItem[]
  emailLogs            EmailLog[]
  couponId             String?
  coupon               Discount?  @relation("CartCoupon", fields: [couponId], references: [id], onDelete: SetNull)
  discountTotal        Float      @default(0)
  subtotal             Float?
  discountUsages       DiscountUsage[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([couponId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  code      String      @unique
  subtotal  Float?
  discountTotal Float   @default(0)
  total     Float
  email     String?
  guestEmail String?
  status    OrderStatus @default(PAID)
  couponId  String?
  coupon    Discount?   @relation("OrderCoupon", fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?    @db.VarChar(5)
  items     OrderItem[]
  emailLogs EmailLog[]
  discountUsages DiscountUsage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([couponId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  quantity  Int      @default(1)
  price     Float
  discountAmount Float @default(0)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// liên quan việc ghi log email gửi đi
// ghi log email sau khi gửi email trong các trường hợp: đơn hàng thành công/thất bại, giỏ hàng bị bỏ rơi
// Nó đảm bảo:
//    Không gửi trùng
//    Retry nếu lỗi
//    Có log để debug
model EmailLog {
  id         String      @id @default(cuid())
  userId     String?
  orderId    String?
  cartId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cart       Cart?       @relation(fields: [cartId], references: [id], onDelete: SetNull)
  type       EmailType
  status     EmailStatus @default(PENDING)
  retryCount Int         @default(0)
  lastError  String?
  uniqueKey  String      @unique
  createdAt  DateTime    @default(now())
  sentAt     DateTime?
  updatedAt  DateTime    @updatedAt

  @@index([orderId])
  @@index([cartId])
  @@index([userId])
}

model Discount {
  id          String              @id @default(cuid())
  code        String?             @unique @db.VarChar(5)
  name        String
  description String?
  scope       DiscountScope
  value       Float               // percent (0-100) or fixed amount depending on valueType
  valueType   DiscountValueType
  maxValue    Float?
  startAt     DateTime?
  endAt       DateTime?
  minOrderAmount Float?           @default(0)
  allowGuest  Boolean             @default(true)
  maxUsage    Int?
  maxUsagePerUser Int?
  usageCount  Int                 @default(0)
  status      DiscountStatus      @default(ACTIVE)
  products    DiscountProduct[]
  usages      DiscountUsage[]
  carts       Cart[]              @relation("CartCoupon")
  orders      Order[]             @relation("OrderCoupon")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([scope, status])
  @@index([startAt])
  @@index([endAt])
}

model DiscountProduct {
  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

model DiscountUsage {
  id         String               @id @default(cuid())
  discountId String
  userId     String?
  cartId     String?
  orderId    String?
  amount     Float                @default(0)
  status     DiscountUsageStatus  @default(PENDING)
  discount   Discount             @relation(fields: [discountId], references: [id], onDelete: Cascade)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  cart       Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order      Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([userId, discountId])
  @@index([cartId])
  @@index([orderId])
  @@unique([discountId, cartId])
  @@unique([discountId, orderId])
}
